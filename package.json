{
  "name": "spec-sheet-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "guide:shots": "playwright test -c playwright.guide.config.ts",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "db:migrate": "tsx scripts/migrate.mts",
    "admin:create": "tsx scripts/create-admin.mts",
    "admin:reset-password": "tsx scripts/reset-admin-password.mts",
    "ocr:build": "tsx scripts/build-ocr-worker.mts",
    "predev": "npm run ocr:build",
    "prebuild": "npm run ocr:build",
    "postbuild": "tsx scripts/check-bundle.mts"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.8",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pngjs": "7.0.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
